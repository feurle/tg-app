{
  "$schema": "https://opencode.ai/config.json",
  "worktree": {
    "directory": ".."
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--isolated"],
      "enabled": true
    },
    "firefox-devtools": {
      "type": "local",
      "command": ["npx", "-y", "@mozilla/firefox-devtools-mcp@latest"],
      "enabled": true
    }
  }
}
